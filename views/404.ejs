<section style="display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 100px 20px; text-align: center;">
    <h1 style="font-size: 8rem; margin: 0; color: var(--primary);">404</h1>
    <h2 style="font-size: 2rem; margin-bottom: 1rem;"><%= typeof message !== 'undefined' ? message : 'Oops! Link Not Found' %></h2>
    <p style="color: var(--text-muted); font-size: 1.125rem; max-width: 500px; margin-bottom: 3rem;">
        The link you are trying to access might have expired, reached its limit, or doesn't exist.
    </p>
    <a href="/" style="background: var(--primary); color: white; padding: 1rem 2rem; border-radius: 0.75rem; text-decoration: none; font-weight: 600; transition: background 0.3s;">Go Home</a>
</section>
