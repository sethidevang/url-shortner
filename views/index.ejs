<div class="max-w-7xl mx-auto px-8 py-20">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <!-- Hero Text -->
        <div>
            <h1 class="text-7xl md:text-8xl font-black uppercase italic tracking-tighter leading-none mb-8">
                SHORT LINKS, <br>
                <span class="bg-[#FF00E5] text-white px-4">BIG IMPACT.</span>
            </h1>
            <p class="text-xl font-bold text-gray-700 mb-10 max-w-lg leading-relaxed">
                The world's most <span class="underline decoration-4 decoration-[#FFDE03]">aggressive</span> URL shortener. Track everything. Hide nothing.
            </p>
            
            <div id="cta-container" class="flex flex-wrap gap-6">
                <a href="/register" class="brutal-btn bg-[#FFDE03] !text-black px-10 py-5 text-xl font-black uppercase tracking-tight hover:skew-x-[-2deg] hover:bg-yellow-300 transition-all shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] flex items-center justify-center">Get Started Free</a>
                <a href="/login" class="brutal-btn bg-white !text-black px-10 py-5 text-xl font-black uppercase tracking-tight hover:skew-x-[2deg] hover:bg-gray-100 transition-all shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] flex items-center justify-center">Login</a>
            </div>

            <!-- Burner Link Section -->
            <div class="mt-16 relative group max-w-lg">
                <!-- Decorative Black Tag -->
                <div class="absolute -top-6 left-6 bg-black text-white px-4 py-2 font-black uppercase text-xs italic tracking-widest z-20 shadow-brutal">
                    🔥 GHOST LINK ENGINE
                </div>
                
                <div class="brutal-card bg-[#FF5F1F] p-8 pt-10 relative z-10 transition-transform group-hover:-rotate-1 text-white">
                    <h4 class="text-white text-3xl font-black uppercase italic leading-none mb-6">
                        DESTROYS IN <br> 
                        <span class="bg-black text-white dark:bg-[#FF00E5] dark:text-black px-2">48 HOURS.</span>
                    </h4>
                    
                    <form id="burner-form" class="flex flex-col gap-3">
                        <input type="url" id="burner-url" placeholder="PASTE YOUR SECRET URL..." required class="w-full p-4 border-4 border-black font-black outline-none placeholder-gray-800">
                        <button type="submit" class="w-full bg-black text-white p-4 font-black uppercase text-xl border-4 border-black shadow-brutal hover:bg-white hover:text-black hover:translate-x-1 hover:translate-y-1 hover:shadow-none transition-all">
                            ACTIVATE LINK
                        </button>
                    </form>
                    
                    <div id="burner-result" class="mt-6 hidden p-4 bg-white border-4 border-black font-black text-center text-sm break-all animate-pulse">
                        <!-- Result -->
                    </div>
                </div>
                <!-- Offset Background -->
                <div class="absolute inset-0 bg-black translate-x-3 translate-y-3 -z-10"></div>
            </div>
        </div>

        <!-- Hero Feature Card -->
        <div class="relative">
            <div class="brutal-card bg-white p-10 relative z-10 rotate-2 hover:rotate-0 transition-transform duration-300">
                <div class="bg-black text-white px-4 py-1 font-black text-xs uppercase mb-6 inline-block">Pro Feature: Analytics</div>
                <h3 class="text-4xl font-black uppercase mb-4 leading-none">
                    <span class="dark:bg-[#FF00E5] dark:text-black dark:px-2 inline-block">TRACK EVERY CLICK.</span>
                </h3>
                <p class="font-bold text-gray-600 mb-8">See exactly who is clicking your links, where they are from, and what device they use. Real-time, brutal honesty.</p>
                
                <div class="flex gap-2">
                    <div class="h-4 w-full bg-blue-600 border-2 border-black"></div>
                    <div class="h-4 w-1/2 bg-yellow-400 border-2 border-black"></div>
                    <div class="h-4 w-1/4 bg-pink-500 border-2 border-black"></div>
                </div>
            </div>
            <!-- Decorative Background Element -->
            <div class="absolute inset-0 bg-[#FFDE03] border-4 border-black -rotate-3 translate-x-4 translate-y-4"></div>
        </div>
    </div>

    <!-- Feature Section -->
    <div class="mt-40 grid grid-cols-1 md:grid-cols-3 gap-12">
        <div class="brutal-card bg-white p-8 hover:-translate-y-2 transition-transform">
            <div class="text-4xl mb-6">🔒</div>
            <h4 class="text-2xl font-black uppercase mb-3">
                <span class="dark:bg-[#FF00E5] dark:text-black dark:px-2 inline-block">Custom Domains</span>
            </h4>
            <p class="font-bold text-gray-600 italic">Use your own domain. Build your own brand. Stay brutal.</p>
        </div>
        <div class="brutal-card bg-white p-8 hover:-translate-y-2 transition-transform">
            <div class="text-4xl mb-6">📂</div>
            <h4 class="text-2xl font-black uppercase mb-3">
                <span class="dark:bg-[#FF00E5] dark:text-black dark:px-2 inline-block">Folder Management</span>
            </h4>
            <p class="font-bold text-gray-600 italic">Organize your links like a pro. File explorer UI included.</p>
        </div>
        <div class="brutal-card bg-white p-8 hover:-translate-y-2 transition-transform">
            <div class="text-4xl mb-6">⚡</div>
            <h4 class="text-2xl font-black uppercase mb-3">
                <span class="dark:bg-[#FF00E5] dark:text-black dark:px-2 inline-block">Instant Speed</span>
            </h4>
            <p class="font-bold text-gray-600 italic">Fastest redirection on the planet. No delays. No bloat.</p>
        </div>
    </div>
</div>

<script>
    const token = localStorage.getItem('token');
    if (token) {
        document.getElementById('cta-container').innerHTML = `
            <a href="/dashboard" class="brutal-btn bg-[#FFDE03] !text-black px-10 py-5 text-xl font-black uppercase tracking-tight italic hover:skew-x-[-5deg] shadow-[6px_6px_0px_0px_rgba(0,0,0,1)] flex items-center justify-center">Go to Dashboard</a>
        `;
    }

    document.getElementById('burner-form').addEventListener('submit', async (e) => {
        e.preventDefault();
        const url = document.getElementById('burner-url').value;
        const res = await fetch('/api/url/burner', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ url })
        });
        const data = await res.json();
        if (data.shortId) {
            const shortUrl = `${window.location.origin}/${data.shortId}`;
            const resultDiv = document.getElementById('burner-result');
            resultDiv.innerHTML = `
                <div class="flex flex-col items-center gap-4">
                    <div class="w-full text-left">
                        <p class="text-[10px] text-gray-400 mb-1">GHOST LINK READY</p>
                        <a href="${shortUrl}" target="_blank" class="text-lg text-blue-600 underline decoration-2">${shortUrl}</a>
                    </div>
                    <div class="bg-white p-2 border-2 border-black shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]">
                        <img src="${data.qrCode}" class="w-24 h-24">
                    </div>
                    <p class="text-[9px] text-gray-500 italic">Self-destructs in 48 hours.</p>
                </div>
            `;
            resultDiv.classList.remove('hidden');
            document.getElementById('burner-url').value = '';
        }
    });
</script>
