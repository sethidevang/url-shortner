<script>
    let currentProjectId = null;
    let charts = { device: null, country: null };

    let currentPage = 1;
    let totalPages = 1;

    // --- MASTER INITIALIZATION ---
    async function loadDashboard(projectId = currentProjectId, page = currentPage) {
        currentProjectId = projectId;
        currentPage = page;
        const token = localStorage.getItem('token');
        if (!token) return window.location.href = '/login';

        try {
            await Promise.allSettled([
                fetchStats(projectId, page),
                fetchLinks(projectId, page),
                fetchProjects(),
                fetchUserDomains()
            ]);
        } catch (err) {
            console.error('ENGINE FAILURE:', err);
        }
    }

    // --- DATA PIPELINE ---
    async function fetchLinks(projectId = null, page = 1) {
        const token = localStorage.getItem('token');
        let url = `/api/url/my-urls?page=${page}`;
        if (projectId) url += `&projectId=${projectId}`;

        const res = await fetch(url, { headers: { 'Authorization': `Bearer ${token}` } });
        if (res.status === 401) return window.location.href = '/login';

        const links = await res.json();
        renderLinks(links);
    }

    async function fetchStats(projectId = null, page = 1) {
        const token = localStorage.getItem('token');
        let url = `/api/dashboard/stats?page=${page}`;
        if (projectId) url += `&projectId=${projectId}`;

        const res = await fetch(url, { headers: { 'Authorization': `Bearer ${token}` } });
        if (!res.ok) return;
        const data = await res.json();

        const stats = data.summary;
        totalPages = stats.totalPages;

        document.getElementById('stat-total-urls').innerText = stats.totalUrls || 0;
        document.getElementById('stat-total-clicks').innerText = stats.totalClicks || 0;
        document.getElementById('stat-real-clicks').innerText = stats.realClicks || 0;
        document.getElementById('stat-bot-clicks').innerText = stats.botClicks || 0;

        // Update Pagination Bar
        document.getElementById('page-info').innerText = `Page ${stats.currentPage} of ${stats.totalPages}`;
        document.getElementById('prev-btn').disabled = stats.currentPage <= 1;
        document.getElementById('next-btn').disabled = stats.currentPage >= stats.totalPages;

        // Render charts from API response
        if (data.deviceData && data.countryData) {
            renderCharts(data.deviceData, data.countryData);
        }
    }

    function renderCharts(deviceData, countryData) {
        if (charts.device) { charts.device.destroy(); charts.device = null; }
        if (charts.country) { charts.country.destroy(); charts.country = null; }

        const isDark = document.documentElement.classList.contains('dark');
        const textColor = isDark ? '#00F5FF' : '#000';
        const gridColor = isDark ? 'rgba(0,245,255,0.1)' : 'rgba(0,0,0,0.1)';

        const deviceCtx = document.getElementById('deviceChart');
        const countryCtx = document.getElementById('countryChart');
        if (!deviceCtx || !countryCtx) return;

        if (deviceData.length === 0) {
            deviceCtx.parentElement.innerHTML += '<p class="text-center text-gray-400 font-black uppercase text-xs mt-4">No data yet</p>';
        } else {
            charts.device = new Chart(deviceCtx, {
                type: 'doughnut',
                data: {
                    labels: deviceData.map(d => d.device),
                    datasets: [{ data: deviceData.map(d => d.count), backgroundColor: ['#FF00E5', '#00F5FF', '#FFDE03', '#3D5AFE'], borderWidth: 0 }]
                },
                options: { plugins: { legend: { position: 'bottom', labels: { color: textColor, font: { weight: 'bold' } } } }, cutout: '65%' }
            });
        }

        if (countryData.length === 0) {
            countryCtx.parentElement.innerHTML += '<p class="text-center text-gray-400 font-black uppercase text-xs mt-4">No data yet</p>';
        } else {
            charts.country = new Chart(countryCtx, {
                type: 'bar',
                data: {
                    labels: countryData.map(c => c.country),
                    datasets: [{ label: 'Clicks', data: countryData.map(c => c.count), backgroundColor: '#FFDE03', borderColor: '#000', borderWidth: 2 }]
                },
                options: { plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { color: textColor, font: { weight: 'bold' } }, grid: { color: gridColor } }, x: { ticks: { color: textColor, font: { weight: 'bold' } }, grid: { display: false } } } }
            });
        }
    }

    function changePage(step) {
        const next = currentPage + step;
        if (next >= 1 && next <= totalPages) {
            loadDashboard(currentProjectId, next);
        }
    }

    async function fetchProjects() {
        const token = localStorage.getItem('token');
        const res = await fetch('/api/project', { headers: { 'Authorization': `Bearer ${token}` } });
        if (!res.ok) return;

        const projects = await res.json();
        const sidebar = document.getElementById('sidebar-projects');
        const dropdown = document.getElementById('link-project');
        if (!sidebar || !dropdown) return;

        sidebar.innerHTML = '';
        dropdown.innerHTML = '<option value="">General (No Folder)</option>';

        projects.forEach(p => {
            const btn = document.createElement('button');
            btn.className = `sidebar-btn flex items-center gap-3 p-3 font-bold border-2 border-black dark:border-white text-black dark:text-white shadow-brutal hover:bg-[#FFDE03] dark:hover:bg-[#00F5FF] dark:hover:text-black transition-all ${currentProjectId === p.id ? 'active bg-[#FFDE03] dark:bg-[#00F5FF] dark:!text-black' : ''}`;
            btn.onclick = () => filterByProject(p.id, p.name);
            btn.innerHTML = `<span>📁 ${p.name.toUpperCase()}</span>`;
            sidebar.appendChild(btn);

            const opt = document.createElement('option');
            opt.value = p.id; opt.textContent = p.name;
            dropdown.appendChild(opt);
        });
    }

    async function fetchUserDomains() {
        const token = localStorage.getItem('token');
        const res = await fetch('/api/domain', { headers: { 'Authorization': `Bearer ${token}` } });
        if (!res.ok) return;

        const domains = await res.json();
        const selectors = [document.getElementById('link-domain'), document.getElementById('modal-link-domain')];
        selectors.forEach(select => {
            if (!select) return;
            select.innerHTML = `<option value="">${select.id.includes('modal') ? 'shorten.io' : 'shorten.io (Default)'}</option>`;
            domains.forEach(d => {
                if (d.isVerified) {
                    const opt = document.createElement('option');
                    opt.value = d.id; opt.textContent = d.domainName;
                    select.appendChild(opt);
                }
            });
        });
    }

    // --- UI RENDERING ---
    function renderLinks(links) {
        const tbody = document.getElementById('links-tbody');
        if (!tbody) return;
        tbody.innerHTML = '';

        if (!links || links.length === 0) {
            tbody.innerHTML = '<tr><td colspan="5" class="p-8 text-center font-black uppercase text-gray-400">No links found</td></tr>';
            return;
        }

        links.forEach(link => {
            const tr = document.createElement('tr');
            tr.className = 'border-b border-black/10 dark:border-[#00F5FF]/20 hover:bg-gray-50 dark:hover:bg-white/5 transition-all cursor-pointer';
            tr.onclick = () => showLinkDetails(link.id);

            const clicks = link.clickCount || 0;
            const domain = link.Domain ? link.Domain.domainName : 'shorten.io';
            const fullUrl = `http://${domain}/${link.shortId}`;

            tr.innerHTML = `
                <td class="p-4"><div class="flex flex-col"><span class="font-black text-sm text-blue-600 dark:text-[#00F5FF] underline">${domain}/${link.shortId}</span><span class="text-[10px] text-gray-500 dark:text-gray-400 truncate max-w-[200px]">${link.redirectUrl}</span></div></td>
                <td class="p-4"><span class="px-2 py-1 bg-black dark:bg-[#FF00E5] text-white text-[10px] font-black uppercase">${link.projectId ? 'FOLDER' : 'GENERAL'}</span></td>
                <td class="p-4 text-xs font-bold text-gray-500 dark:text-gray-300 italic truncate max-w-[150px]">${link.redirectUrl}</td>
                <td class="p-4 text-center"><span class="font-black text-black dark:text-black bg-[#FFDE03] px-3 py-1 text-sm border-2 border-black">${clicks}</span></td>
                <td class="p-4 text-center">
                    <img src="https://api.qrserver.com/v1/create-qr-code/?size=100x100&data=${encodeURIComponent(fullUrl)}" class="w-10 h-10 mx-auto border-2 border-black dark:border-white">
                </td>
            `;
            tbody.appendChild(tr);
        });
    }

    // --- ACTIONS ---
    async function createLink(e) {
        if (e) e.preventDefault();
        const payload = {
            redirectUrl: document.getElementById('link-url').value,
            customId: document.getElementById('link-slug').value,
            projectId: document.getElementById('link-project').value || null,
            domainId: document.getElementById('link-domain').value || null
        };

        const res = await fetch('/api/url', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${localStorage.getItem('token')}` },
            body: JSON.stringify(payload)
        });

        if (res.ok) {
            document.getElementById('link-url').value = '';
            document.getElementById('link-slug').value = '';
            loadDashboard(currentProjectId);
        } else {
            const data = await res.json();
            alert(data.error || 'Failed to create link');
        }
    }

    async function createProject(e) {
        e.preventDefault();
        const name = document.getElementById('project-name').value;
        const res = await fetch('/api/project', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${localStorage.getItem('token')}` },
            body: JSON.stringify({ name })
        });
        if (res.ok) { closeProjectModal(); document.getElementById('project-name').value = ''; loadDashboard(); }
    }

    async function showLinkDetails(id) {
        const res = await fetch(`/api/url/${id}`, { headers: { 'Authorization': `Bearer ${localStorage.getItem('token')}` } });
        const link = await res.json();
        const domain = link.Domain ? link.Domain.domainName : 'shorten.io';
        const fullUrl = `http://${domain}/${link.shortId}`;

        document.getElementById('modal-short-id').innerText = `/${link.shortId}`;
        document.getElementById('modal-long-url').innerText = link.redirectUrl;
        document.getElementById('modal-clicks').innerText = link.Visits ? link.Visits.length : 0;
        document.getElementById('modal-date').innerText = new Date(link.createdAt).toLocaleDateString();
        document.getElementById('modal-qr').src = `https://api.qrserver.com/v1/create-qr-code/?size=300x300&data=${encodeURIComponent(fullUrl)}`;

        window.currentModalFullUrl = fullUrl;
        window.currentModalLinkId = id;
        document.getElementById('link-modal').classList.remove('hidden');
    }

    // --- HELPERS ---
    function logout() { localStorage.removeItem('token'); window.location.href = '/login'; }
    function toggleAdvanced() { document.getElementById('advanced-options').classList.toggle('hidden'); }
    function updatePreview() {
        const slug = document.getElementById('link-slug').value || '...';
        const domainSelect = document.getElementById('link-domain');
        const domain = domainSelect.value ? domainSelect.options[domainSelect.selectedIndex].text : 'shorten.io';
        document.getElementById('link-preview').innerHTML = `${domain}/<span class="${slug === '...' ? 'opacity-30' : ''}">${slug}</span>`;
    }
    function updateModalPreview() {
        const slug = document.getElementById('modal-link-slug').value || '...';
        const domainSelect = document.getElementById('modal-link-domain');
        const domain = domainSelect.value ? domainSelect.options[domainSelect.selectedIndex].text : 'shorten.io';
        document.getElementById('modal-link-preview').innerHTML = `${domain}/<span class="${slug === '...' ? 'opacity-30' : ''}">${slug}</span>`;
    }

    function openCreateModal() { document.getElementById('create-modal').classList.remove('hidden'); }
    function closeCreateModal() { document.getElementById('create-modal').classList.add('hidden'); }
    function showProjectModal() { document.getElementById('project-modal').classList.remove('hidden'); }
    function closeProjectModal() { document.getElementById('project-modal').classList.add('hidden'); }
    function closeLinkModal() { document.getElementById('link-modal').classList.add('hidden'); }
    function copyToClipboard() { navigator.clipboard.writeText(window.currentModalFullUrl); alert('COPIED! 📋'); }

    function filterByProject(id, name) {
        currentProjectId = id;
        document.getElementById('btn-all').classList.toggle('active', !id);
        const titleText = document.getElementById('title-text');
        if (titleText) titleText.textContent = name || 'Dashboard';
        loadDashboard(id);
    }
    function toggleSidebar() { document.getElementById('dashboard-sidebar').classList.toggle('hidden'); }
    function openDomainGuide() { document.getElementById('domain-guide-modal').classList.remove('hidden'); }
    function closeDomainGuide() { document.getElementById('domain-guide-modal').classList.add('hidden'); }

    function copyCNAME() {
        const target = document.getElementById('cname-target');
        navigator.clipboard.writeText(target.value);
        alert('CNAME Copied! ✅');
    }

    function shareLink() {
        const url = window.currentModalFullUrl;
        if (navigator.share) {
            navigator.share({ title: 'Short Link', url });
        } else {
            navigator.clipboard.writeText(url);
            alert('Link copied! 📋');
        }
    }

    async function createLinkModal(e) {
        e.preventDefault();
        const payload = {
            redirectUrl: document.getElementById('modal-link-url').value,
            customId: document.getElementById('modal-link-slug').value || undefined,
            domainId: document.getElementById('modal-link-domain').value || null
        };
        const res = await fetch('/api/url', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${localStorage.getItem('token')}` },
            body: JSON.stringify(payload)
        });
        if (res.ok) {
            closeCreateModal();
            document.getElementById('modal-link-url').value = '';
            document.getElementById('modal-link-slug').value = '';
            loadDashboard(currentProjectId);
        } else {
            const d = await res.json();
            alert(d.error || 'Failed to create link');
        }
    }

    // --- START ---
    document.getElementById('dashboard-shorten-form').addEventListener('submit', createLink);
    loadDashboard();
</script>